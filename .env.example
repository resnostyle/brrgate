LISTEN_ADDR=:8080
WEBHOOK_SECRET=changeme-long-random-token
MATCH_FIELD=torrent
LOG_LEVEL=info

# Point to YAML rules (recommended). Starter file: config/patterns.yaml
PATTERNS_FILE=./config/patterns.yaml

# Fallback single-regex if PATTERNS_FILE is empty
# AUTO_ACCEPT_REGEX=(?i).*FLAC.*

# Blocking manual approvals toggle
DEBUG_APPROVAL=false
DEBUG_TIMEOUT=120s
DEBUG_UI_LISTEN_ADDR=127.0.0.1:8091

# --- Docker Compose ---
# Compose bind-mounts ${PATTERNS_DIR:-./config} -> /config; the container reads /config/patterns.yaml.
# This repo includes config/patterns.yaml as a starter file—edit it or point PATTERNS_DIR elsewhere.
# Override published ports via PUBLISH_LISTEN/PUBLISH_DEBUG if needed.
